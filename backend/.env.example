# Environnement SIPAT Backend
NODE_ENV=development
PORT=5000
API_PREFIX=/api/v1

# Connexion Base de Données Souveraine MySQL 8.4 (Datacenter Gouvernemental)
DATABASE_URL="mysql://root:@localhost:3306/sipat_db?connect_timeout=30"

# Sécurité & Chiffrement JWT
JWT_ACCESS_SECRET="SIPAT_GOV_CONGO_ACCESS_SECRET_KEY_CHANGE_IN_PROD_MIN_32_BYTES_STRONG"
JWT_REFRESH_SECRET="SIPAT_GOV_CONGO_REFRESH_SECRET_KEY_CHANGE_IN_PROD_MIN_32_BYTES_STRONG"
JWT_ACCESS_EXPIRATION="15m"
JWT_REFRESH_EXPIRATION="7d"

# Sécurité CORS & Origines Autorisées
CORS_ORIGIN="http://localhost:5173,http://localhost:3000"

# Journalisation & Audit
LOG_LEVEL=debug
APP_SECRET_SALT_ROUNDS=12

# Comptes fictifs réservés au cadrage local (désactivés par défaut)
SIPAT_SEED_DEMO_USERS=false
SIPAT_DEMO_PASSWORD=
